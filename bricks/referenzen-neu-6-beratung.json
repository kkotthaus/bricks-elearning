  {
   "id": "ufylb6",
   "name": "image-banner",
   "settings": {
    "_position": "relative",
    "_overflow": "hidden",
    "_padding": {
     "top": "var(--section-space-xs)",
     "bottom": "var(--section-space-xs)"
    },
    "_cssCustom": ".image-banner {\n  isolation: isolate;\n}"
   }
  },
  {
   "id": "7en89l",
   "name": "image-banner__image",
   "settings": {
    "_position": "absolute",
    "_top": "0",
    "_right": "0",
    "_bottom": "0",
    "_width": "52%",
    "_height": "100%",
    "_objectFit": "cover",
    "_zIndex": "0",
    "_position:mobile_landscape": "relative",
    "_width:mobile_landscape": "100%",
    "_height:mobile_landscape": "28rem",
    "_margin:mobile_landscape": {
     "bottom": "var(--space-m)"
    },
    "_cssCustom": "/* Weicher Übergang vom Foto in die Fläche (Maske, keine Farbe) */\n.image-banner__image {\n  -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 35%);\n  mask-image: linear-gradient(to right, transparent 0%, #000 35%);\n}\n\n@media (max-width: 767px) {\n  .image-banner__image {\n    -webkit-mask-image: none;\n    mask-image: none;\n    border-radius: var(--radius);\n  }\n}"
   }
  },
  {
   "id": "29wqbq",
   "name": "image-banner__inner",
   "settings": {
    "_position": "relative",
    "_zIndex": "1"
   }
  },
  {
   "id": "nyrp5a",
   "name": "image-banner__content",
   "settings": {
    "_display": "flex",
    "_direction": "column",
    "_rowGap": "var(--space-m)",
    "_width": "50%",
    "_width:tablet_portrait": "62%",
    "_width:mobile_landscape": "100%"
   }
  },
  {
   "id": "2oqnn8",
   "name": "image-banner__title",
   "settings": {
    "_margin": {
     "top": "0",
     "bottom": "0"
    },
    "_widthMax": "100%",
    "_typography": {
     "font-size": "var(--h1)",
     "line-height": "1.15"
    },
    "_cssCustom": ".image-banner__title {\n  overflow-wrap: break-word;\n  hyphens: manual;\n}\n\n/* Hero-Titel laut Vorlage deutlich größer als h1 */\n.image-banner h1.image-banner__title {\n  font-size: calc(var(--h1) * 1.45);\n}"
   }
  },
  {
   "id": "32ni7r",
   "name": "image-banner__lede",
   "settings": {
    "_margin": {
     "top": "0",
     "bottom": "0"
    },
    "_typography": {
     "font-size": "var(--text-l)"
    },
    "_widthMax": "60ch"
   }
  },
  {
   "id": "1q4cgx",
   "name": "image-banner__quote",
   "settings": {
    "_position": "absolute",
    "_top": "12%",
    "_right": "4%",
    "_zIndex": "2",
    "_widthMax": "13ch",
    "_typography": {
     "font-size": "var(--h4)",
     "font-weight": "600",
     "font-style": "italic",
     "line-height": "1.3",
     "color": {
      "raw": "var(--primary-dark)"
     }
    },
    "_display:tablet_portrait": "none",
    "_cssCustom": ".image-banner__quote {\n  transform: rotate(-8deg);\n  hyphens: manual;\n}\n\n/* Schwung unter dem Zitat wie in der Vorlage */\n.image-banner__quote::after {\n  content: \"\";\n  display: block;\n  width: 85%;\n  height: 0.12em;\n  margin-top: 0.35em;\n  margin-left: auto;\n  background: var(--primary);\n  border-radius: 50%;\n  transform: rotate(-4deg);\n}"
   }
  },
  {
