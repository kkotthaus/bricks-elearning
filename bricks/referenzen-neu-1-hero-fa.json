 "source": "bricksCopiedElements",
 "sourceUrl": "http://weka-e.local",
 "version": "2.4.2",
 "globalClasses": [
  {
   "id": "2agw7k",
   "name": "eyebrow--light",
   "settings": {
    "_typography": {
     "color": {
      "raw": "var(--white)"
     }
    }
   }
  },
  {
   "id": "2niotf",
   "name": "icon-circle",
   "settings": {
    "_display": "flex",
    "_alignItems": "center",
    "_justifyContent": "center",
    "_flexShrink": "0",
    "_background": {
     "color": {
      "raw": "var(--primary)"
     }
    },
    "_typography": {
     "color": {
      "raw": "var(--white)"
     }
    },
    "_border": {
     "radius": {
      "top": "50%",
      "right": "50%",
      "bottom": "50%",
      "left": "50%"
     }
    },
    "_cssCustom": ".icon-circle {\n  width: var(--icon-circle-size, 4.4rem);\n  height: var(--icon-circle-size, 4.4rem);\n}\n\n/* Font-Awesome-Symbol im Kreis, Größe relativ zum Kreis */\n.icon-circle > .brxe-icon {\n  font-size: calc(var(--icon-circle-size, 4.4rem) * 0.45);\n  line-height: 1;\n}\n\n/* Linien-Icon (SVG aus der Mediathek) im Kreis */\n.icon-circle > svg {\n  width: 58%;\n  height: 58%;\n}"
   }
  },
  {
   "id": "ufylb6",
   "name": "image-banner",
   "settings": {
    "_position": "relative",
    "_overflow": "hidden",
    "_padding": {
     "top": "var(--section-space-xs)",
     "bottom": "var(--section-space-xs)"
    },
    "_cssCustom": ".image-banner {\n  isolation: isolate;\n}"
   }
  },
  {
   "id": "7en89l",
   "name": "image-banner__image",
   "settings": {
    "_position": "absolute",
    "_top": "0",
    "_right": "0",
    "_bottom": "0",
    "_width": "52%",
    "_height": "100%",
    "_objectFit": "cover",
    "_zIndex": "0",
    "_position:tablet_portrait": "relative",
    "_width:tablet_portrait": "100%",
    "_height:tablet_portrait": "36rem",
    "_margin:tablet_portrait": {
     "bottom": "var(--space-m)"
    },
    "_height:mobile_landscape": "28rem",
    "_cssCustom": "/* Weicher Übergang vom Foto in die Fläche (Maske, keine Farbe) */\n.image-banner__image {\n  -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 35%);\n  mask-image: linear-gradient(to right, transparent 0%, #000 35%);\n}\n\n/* Ab Tablet: Foto über dem Text, damit weiße Schrift nicht auf dem Foto liegt */\n@media (max-width: 991px) {\n  .image-banner__image {\n    -webkit-mask-image: none;\n    mask-image: none;\n    border-radius: var(--radius);\n  }\n}"
   }
  },
  {
   "id": "29wqbq",
   "name": "image-banner__inner",
   "settings": {
    "_position": "relative",
    "_zIndex": "1"
   }
  },
  {
   "id": "nyrp5a",
   "name": "image-banner__content",
   "settings": {
    "_display": "flex",
    "_direction": "column",
    "_rowGap": "var(--space-m)",
    "_width": "50%",
    "_width:tablet_portrait": "100%"
   }
  },
  {
   "id": "2oqnn8",
   "name": "image-banner__title",
   "settings": {
    "_margin": {
     "top": "0",
     "bottom": "0"
    },
    "_widthMax": "100%",
    "_typography": {
     "font-size": "var(--h1)",
     "line-height": "1.15"
    },
    "_cssCustom": ".image-banner__title {\n  overflow-wrap: break-word;\n  hyphens: manual;\n}\n\n/* Hero-Titel laut Vorlage deutlich größer als h1 */\n.image-banner h1.image-banner__title {\n  font-size: calc(var(--h1) * 1.45);\n}"
   }
  },
  {
   "id": "32ni7r",
   "name": "image-banner__lede",
   "settings": {
    "_margin": {
     "top": "0",
     "bottom": "0"
    },
    "_typography": {
     "font-size": "var(--text-l)"
    },
    "_widthMax": "60ch"
   }
  },
  {
   "id": "1q4cgx",
   "name": "image-banner__quote",
   "settings": {
    "_position": "absolute",
    "_top": "12%",
    "_right": "4%",
    "_zIndex": "2",
    "_widthMax": "13ch",
    "_typography": {
     "font-size": "var(--h4)",
     "font-weight": "600",
     "font-style": "italic",
     "line-height": "1.3",
     "color": {
      "raw": "var(--primary-dark)"
     }
    },
    "_display:tablet_portrait": "none",
    "_cssCustom": ".image-banner__quote {\n  transform: rotate(-8deg);\n  hyphens: manual;\n}\n\n/* Schwung unter dem Zitat wie in der Vorlage */\n.image-banner__quote::after {\n  content: \"\";\n  display: block;\n  width: 85%;\n  height: 0.12em;\n  margin-top: 0.35em;\n  margin-left: auto;\n  background: var(--primary);\n  border-radius: 50%;\n  transform: rotate(-4deg);\n}"
   }
  },
  {
   "id": "n4lbw7",
   "name": "stat-list",
   "settings": {
    "_display": "grid",
    "_gridTemplateColumns": "repeat(4, minmax(0, 1fr))",
    "_gridTemplateColumns:tablet_portrait": "repeat(2, minmax(0, 1fr))",
    "_columnGap": "var(--space-s)",
    "_rowGap": "var(--space-m)",
    "_margin": {
     "top": "var(--space-s)",
     "right": "0",
     "bottom": "0",
     "left": "0"
    },
    "_padding": {
     "top": "0",
     "right": "0",
     "bottom": "0",
     "left": "0"
    },
    "_cssCustom": ".stat-list {\n  list-style: none;\n}"
   }
  },
  {
   "id": "ik52pn",
   "name": "stat-list__item",
   "settings": {
    "_display": "flex",
    "_direction": "row",
    "_flexWrap": "nowrap",
    "_alignItems": "center",
    "_columnGap": "var(--space-xs)",
    "_margin": {
     "top": "0",
     "bottom": "0"
    },
    "_cssCustom": "/* Kreisgröße wie Vorlage */\n.stat-list__item {\n  --icon-circle-size: 6.4rem;\n}"
   }
  },
  {
   "id": "m4w9ex",
   "name": "stat-list__value",
   "settings": {
    "_margin": {
     "top": "0",
     "bottom": "0"
    },
